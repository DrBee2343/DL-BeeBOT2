      "validator": "date" },

    { "key": "exp", "type": "text", "box": [1656, 386, 1987, 474], "ink": "dark",
      "font": "RobotoCondensed-Regular.ttf", "size": 62, "color": "#1a1a1a",
      "label": "Expiry date", "prompt": "Send the expiry date.", "hint": "DD-MM-YYYY",
      "validator": "date" },

    { "key": "name", "type": "text", "box": [737, 466, 1954, 550], "ink": "dark",
