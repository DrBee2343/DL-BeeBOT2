{
  "id": "ng_dl",
  "name": "Nigeria Driver's Licence",
  "canvas": [2048, 1293],
  "plate": "ng_dl/plate.png",
  "bezel_crop": [33, 33, 2015, 1260],
  "cost": 1,
  "slots": [
