    { "key": "sex", "type": "text", "box": [853, 722, 906, 778], "ink": "dark",
      "font": "RobotoCondensed-Bold.ttf", "size": 52, "color": "#1a1a1a",
      "label": "Sex", "prompt": "Send M or F.", "hint": "M or F", "validator": "sex" },

    { "key": "ht", "type": "text", "box": [1159, 722, 1325, 778], "ink": "dark",
