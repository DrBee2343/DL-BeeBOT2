      "validator": "text", "default": "0", "editable": false },

    { "key": "ren", "type": "text", "box": [1920, 813, 1950, 869], "ink": "dark",
      "font": "RobotoCondensed-Bold.ttf", "size": 52, "color": "#1a1a1a",
      "validator": "text", "default": "1", "editable": false },

    { "key": "end", "type": "text", "box": [853, 913, 899, 969], "ink": "dark",
      "font": "RobotoCondensed-Bold.ttf", "size": 52, "color": "#1a1a1a",
      "validator": "upper", "default": "P", "editable": false },

    { "key": "nok", "type": "text", "box": [944, 979, 1333, 1035], "ink": "dark",
      "font": "RobotoCondensed-Bold.ttf", "size": 52, "color": "#1a1a1a",
      "label": "Next of kin phone", "prompt": "Send the next-of-kin phone number.",
      "hint": "11 digits, starts with 0", "validator": "phone" },

    { "key": "first_iss", "type": "text", "box": [1184, 1054, 1548, 1110], "ink": "dark",
      "font": "RobotoCondensed-Bold.ttf", "size": 52, "color": "#1a1a1a",
      "label": "First issue date", "prompt": "Send the date of first issue.", "hint": "DD-MM-YYYY",
      "validator": "date" },

    { "key": "holder_sign", "type": "text", "box": [993, 1078, 1423, 1194], "ink": "dark",
      "font": "MrsSaintDelafield-Regular.ttf", "size": 88, "color": "#1a1a1a",
      "editable": false }
  ]
